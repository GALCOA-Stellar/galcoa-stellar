# Clave SECRETA de una cuenta de Stellar TESTNET (empieza con S). Nunca una clave de la red principal.
# Se genera con: npm run crear-cuenta  (escribe .env.local, que no va a git)
SELLADOR_STELLAR_SECRETO=

# Acceso por firma de cuenta (SEP-53). En producción son obligatorias.
# Cuentas de Stellar (empiezan con G, separadas por coma) autorizadas a confirmar sellos:
CUENTAS_AUTORIZADAS=
# Opcional: GAAA...=aprobador-01 asocia la cuenta a un identificador interno (cuatro ojos: no puede haber cargado documentos del lote)
# Secreto largo y aleatorio con el que el servidor firma los mensajes que emite (no es una clave de Stellar):
DESAFIO_SECRETO=

# Sello 2 de 2 (multifirma nativa). Cuenta PÚBLICA (G...) cuya configuración en la red exige dos firmas; se crea con: npm run configurar-2de2
CUENTA_SELLADORA_2DE2=

# Modo demostración (SOLO local/testnet): firma el 2 de 2 con dos claves de prueba del servidor. Apagado por defecto; ignorado en producción.
# Las dos cuentas (sus G...) deben estar en CUENTAS_AUTORIZADAS y como firmantes de CUENTA_SELLADORA_2DE2.
MODO_DEMO=
DEMO_SECRETO_CARGADOR=
DEMO_SECRETO_APROBADOR=

# Tope de comisión por operación en stroops (100 = 0,00001 XLM). Por defecto 10000 (0,001 XLM). Nunca se paga más que esto.
COMISION_MAXIMA_STROOPS=

# Contrato registro-lotes desplegado en testnet (C...). Si está, el verificador muestra quién cargó y quién aprobó.
CONTRATO_REGISTRO_ID=

# Cupo de sellos por cuenta y por día UTC (el servicio paga las comisiones). Por defecto 20; 0 lo apaga (solo desarrollo).
#CUPO_DIARIO=20
